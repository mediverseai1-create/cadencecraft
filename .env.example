# Payments: hosted payment links, one per plan
NEXT_PUBLIC_PAYMENT_LINK_ESSENTIALS=
NEXT_PUBLIC_PAYMENT_LINK_CORE=
NEXT_PUBLIC_PAYMENT_LINK_PLUS=
NEXT_PUBLIC_PAYMENT_LINK_PRO=
